# Copy this file to .env.local (for your computer) and add the same values in your host's
# "Environment Variables" settings. See README → "Environment variables".

# Supabase → Project Settings → API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# SECRET — never share, never commit, never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_xxx

# Random secret shared with Supabase (private.app_secrets) so only /api/orders can place orders
ORDER_API_SECRET=replace-me
